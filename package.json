{
  "name": "codex-context-diet",
  "version": "0.6.1",
  "description": "Codex plugin that asks TypeSafe's Jev which bulky tool results the session still needs, and replaces the rest with a bounded head plus a note.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "context-diet": "./dist/cli.js"
  },
  "files": [
    "dist",
    "hooks",
    "skills",
    "schemas",
    "assets",
    "evals",
    "examples",
    "docs",
    "scripts",
    "plugin.json",
    "mcp.json",
    ".codex-plugin",
    ".mcp.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "validate:plugin": "node scripts/validate-plugin.mjs",
    "bench:hooks": "node scripts/bench-hooks.mjs",
    "bench:stages": "node scripts/bench-stages.mjs",
    "eval:prompts": "node scripts/eval-prompts.mjs",
    "eval:guards": "node scripts/eval-guards.mjs",
    "eval:decisions": "node dist/cli.js eval",
    "doctor": "node dist/cli.js doctor",
    "release": "node scripts/release.mjs",
    "verify": "node dist/cli.js verify",
    "demo:live": "node examples/live-demo.mjs",
    "sync:manifest": "node scripts/sync-manifest.mjs",
    "install:check": "node scripts/install-check.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
