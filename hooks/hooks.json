{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "context-diet",
            "tool": "post_tool_use",
            "input": {
              "session_id": "${session_id}",
              "tool_name": "${tool_name}",
              "tool_input": "${tool_input}",
              "tool_response": "${tool_response}",
              "tool_use_id": "${tool_use_id}",
              "cwd": "${cwd}"
            },
            "timeout": 10,
            "statusMessage": "Judging tool output"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "context-diet",
            "tool": "session_event",
            "input": {
              "session_id": "${session_id}",
              "event": "SessionStart"
            },
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "context-diet",
            "tool": "prompt_guard",
            "input": {
              "session_id": "${session_id}",
              "prompt": "${prompt}",
              "cwd": "${cwd}"
            },
            "timeout": 5
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "context-diet",
            "tool": "pre_compact",
            "input": {
              "session_id": "${session_id}",
              "trigger": "${trigger}"
            },
            "timeout": 10
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "context-diet",
            "tool": "post_compact",
            "input": {
              "session_id": "${session_id}",
              "trigger": "${trigger}"
            },
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "context-diet",
            "tool": "stop_guard",
            "input": {
              "session_id": "${session_id}"
            },
            "timeout": 5
          }
        ]
      }
    ]
  }
}
